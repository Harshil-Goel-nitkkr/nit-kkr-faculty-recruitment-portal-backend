# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/nitkkr_recruitment?retryWrites=true&w=majority

# Server
PORT=5000
NODE_ENV=development

# JWT
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
ADMIN_JWT_SECRET=replace_with_another_long_random_secret
ADMIN_JWT_EXPIRES_IN=1d
COOKIE_MAX_AGE_DAYS=7

# OTP
OTP_EXPIRY_MINUTES=10

# Nodemailer (institute mail account used to send OTPs / notifications)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=recruitment@nitkkr.ac.in
SMTP_PASS=replace_with_app_password
MAIL_FROM="NIT Kurukshetra Recruitment Portal <recruitment@nitkkr.ac.in>"
INSTITUTE_CONTACT_EMAIL=recruitment@nitkkr.ac.in

# Frontend URL (for CORS)
FRONTEND_URL=http://localhost:3000
ADMIN_URL=http://localhost:3001

# File uploads
MAX_FILE_SIZE_MB=5

# Payment (gateway keys -  Razorpay)
RAZORPAY_KEY_ID=replace_with_key_id
RAZORPAY_KEY_SECRET=replace_with_key_secret

# Captcha (redis Url)
REDIS_URL=

#Cloudinary
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

#Mailjet  (3rd party mailing service)
MAILJET_API_KEY_PUBLIC=
MAILJET_API_KEY_PRIVATE=